{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["vite/client"],
    // Vite resolves the `.ts` extension itself at bundle time; the same reason
    // `examples/navigation` sets this for Node's own type-stripping.
    "allowImportingTsExtensions": true
  },
  "include": ["src"]
}
